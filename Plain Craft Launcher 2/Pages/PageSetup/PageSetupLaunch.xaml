                                      local:SettingService.Key="PrecheckWarnDuplicate"
                                      ToolTip="同一实例内出现多个相同 ModId 的启用文件时，启动前弹窗警告并支持一键禁用重复副本。" />
                    <local:MyCheckBox Height="28" Text="拦截加载器错放（如 Fabric 放进 Forge / NeoForge）"
                                      local:SettingService.Key="PrecheckWarnLoader"
