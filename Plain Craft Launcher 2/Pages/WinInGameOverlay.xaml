<Window x:Class="WinInGameOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Width="408"
        SizeToContent="Height"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="OverlayPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF24344D" />
            <Setter Property="Foreground" Value="#FFF1F5F9" />
            <Setter Property="BorderBrush" Value="#FF3B5278" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2F4466" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5577AA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1E2B40" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource OverlayPillButtonStyle}">
            <Setter Property="Background" Value="#FF14382F" />
            <Setter Property="Foreground" Value="#FFD1FAE5" />
            <Setter Property="BorderBrush" Value="#FF237059" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1B4B3F" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF34D399" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF102D25" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF0284C7" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF0EA5E9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF0369A1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFCBD5E1" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44EF4444" />
                                <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayIconNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF25344E" />
            <Setter Property="Foreground" Value="#FFF1F5F9" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF33496B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayInputBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FF1C273B" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="CaretBrush" Value="#FF38BDF8" />
            <Setter Property="SelectionBrush" Value="#FF0284C7" />
            <Setter Property="BorderBrush" Value="#FF364B6B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF38BDF8" />
                                <Setter TargetName="Bd" Property="Background" Value="#FF212E46" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <!-- 底层独立阴影背板：绝不包裹任何文字控件，确保字体使用 ClearType 清晰渲染 -->
        <Border CornerRadius="12" Background="#FF0B1120" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>

        <!-- 前景清晰卡片主体 -->
        <Border CornerRadius="12"
                Background="#FA131B2B"
                BorderBrush="#FF324869"
                BorderThickness="1.2"
                Padding="15,12">
            <StackPanel>
                <!-- 顶栏（支持拖动） -->
                <Grid x:Name="GridHeader" Background="Transparent" Cursor="SizeAll" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#FF38BDF8" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="PCL Linking 游戏内浮层" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                        <Border x:Name="BorderLinkBadge" CornerRadius="9" Background="#FF173654" BorderBrush="#FF295F8E"
                                BorderThickness="1" Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="LabOverlayLinkState" Text="" Foreground="#FF7DD3FC" FontSize="11.5" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnToggleBorderless" Content="无边框" Height="24" Padding="9,0" Margin="0,0,6,0"
                            Style="{StaticResource OverlayGreenButtonStyle}"
                            ToolTip="将运行中的 Minecraft 窗口切换为无边框全屏 / 恢复窗口模式" />
                    <Button Grid.Column="2" x:Name="BtnOpenFriends" Content="好友" Height="24" Padding="9,0" Margin="0,0,4,0"
                            Style="{StaticResource OverlayPillButtonStyle}"
                            ToolTip="回到主界面打开好友列表" />
                    <Button Grid.Column="3" x:Name="BtnCloseOverlay" Content="×"
                            Style="{StaticResource OverlayCloseButtonStyle}"
                            ToolTip="关闭浮层 (Esc)" />
                </Grid>

                <!-- 游戏运行性能监控条 -->
                <Border CornerRadius="7" Background="#FF1B263B" BorderBrush="#FF2E3F5C" BorderThickness="1"
                        Padding="10,6" Margin="0,0,0,8">
                    <TextBlock x:Name="LabOverlayPerf" Text="当前无运行中的游戏实例" Foreground="#FFE2E8F0" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- 好友切换栏 -->
                <Border CornerRadius="7" Background="#FF1B263B" BorderBrush="#FF2E3F5C" BorderThickness="1"
                        Padding="4" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BtnPrevFriend" Content="‹" Style="{StaticResource OverlayIconNavButtonStyle}" />
                        <TextBlock Grid.Column="1" x:Name="LabOverlayFriend" Text="暂无好友" Foreground="#FFFFFFFF"
                                   FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="10,0" />
                        <Button Grid.Column="2" x:Name="BtnNextFriend" Content="›" Style="{StaticResource OverlayIconNavButtonStyle}" />
                    </Grid>
                </Border>

                <!-- 最近消息滚动区 -->
                <ScrollViewer x:Name="ScrollOverlayMessages" MaxHeight="220"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                    <StackPanel x:Name="PanOverlayMessages" />
                </ScrollViewer>

                <!-- 联机邀请快捷栏（仅收到邀请时显示） -->
                <Border x:Name="PanInviteBar" Visibility="Collapsed" CornerRadius="8"
                        Background="#FF152C47" BorderBrush="#FF38BDF8" BorderThickness="1"
                        Padding="9,8" Margin="0,2,0,8">
                    <StackPanel>
                        <TextBlock Text="收到联机房间邀请，可免切屏立即加入：" Foreground="#FFBAE6FD" FontSize="11.5" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnOverlayJoinRoom" Content="一键加入房间" Height="27" Margin="0,0,8,0"
                                    Style="{StaticResource OverlayPrimaryButtonStyle}" />
                            <Button x:Name="BtnOverlayJoinPlay" Content="进房并直连游戏" Height="27"
                                    Style="{StaticResource OverlayPillButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 底部快捷回复栏 -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TextQuickReply" Height="32" MaxLength="400"
                             Style="{StaticResource OverlayInputBoxStyle}"
                             ToolTip="输入消息按 Enter 快捷回复，按 Esc 隐藏浮层" />
                    <TextBlock Grid.Column="0" IsHitTestVisible="False" Text="快捷回复 (Enter 发送)…" Foreground="#FF8FA3BF"
                               FontSize="12" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=TextQuickReply}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" x:Name="BtnQuickSend" Content="发送" Width="62" Height="32" Margin="8,0,0,0"
                            Style="{StaticResource OverlayPrimaryButtonStyle}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
