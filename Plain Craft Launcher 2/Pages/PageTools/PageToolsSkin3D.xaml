<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageToolsSkin3D"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,40">

            <local:MyCard Title="皮肤来源" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <WrapPanel Margin="0,0,0,12">
                        <local:MyButton x:Name="BtnLoadCurrentSkin" Text="读取当前账号皮肤" MinWidth="136" Height="32" Padding="14,0" ColorType="Highlight" Margin="0,0,10,6" />
                        <local:MyButton x:Name="BtnLoadLocalSkin" Text="选择本地皮肤 (.png)" MinWidth="136" Height="32" Padding="14,0" Margin="0,0,10,6" />
                        <local:MyButton x:Name="BtnLoadLocalCape" Text="选择本地披风 (.png)" MinWidth="136" Height="32" Padding="14,0" Margin="0,0,10,6" />
                        <local:MyButton x:Name="BtnSnapshotView" Text="保存 3D 截图" MinWidth="116" Height="32" Padding="14,0" Margin="0,0,10,6" />
                        <local:MyComboBox x:Name="ComboAvatarSize" Width="88" Height="32" Margin="0,0,6,6" ToolTip="导出头像分辨率">
                            <local:MyComboBoxItem Content="64×64" IsSelected="True" Tag="64" />
                            <local:MyComboBoxItem Content="96×96" Tag="96" />
                            <local:MyComboBoxItem Content="128×128" Tag="128" />
                        </local:MyComboBox>
                        <local:MyButton x:Name="BtnExportAvatar" Text="导出头像 (.png)" MinWidth="118" Height="32" Padding="12,0" Margin="0,0,0,6" />
                    </WrapPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="正版玩家名" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyTextBox Grid.Column="1" x:Name="TextLookupName" HintText="输入正版玩家名" Margin="0,0,8,0" />
                        <local:MyButton Grid.Column="2" x:Name="BtnLookupMojang" Text="在线获取" MinWidth="92" Height="28" Padding="10,0" />
                    </Grid>
                    <TextBlock x:Name="LabSkinInfo" Margin="0,10,0,0" FontSize="12.5" Foreground="{DynamicResource ColorBrush2}" Text="默认 Steve" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="3D 预览" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <WrapPanel Margin="0,0,0,12">
                        <TextBlock Text="手臂模型" VerticalAlignment="Center" Margin="0,0,10,6" />
                        <local:MyComboBox x:Name="ComboArmModel" Width="130" Margin="0,0,18,6">
                            <local:MyComboBoxItem Content="经典 (Steve)" IsSelected="True" Tag="0" />
                            <local:MyComboBoxItem Content="纤细 (Alex)" Tag="1" />
                        </local:MyComboBox>
                        <TextBlock Text="动作姿态" VerticalAlignment="Center" Margin="0,0,10,6" />
                        <local:MyComboBox x:Name="ComboPoseMode" Width="116" Margin="0,0,18,6">
                            <local:MyComboBoxItem Content="行走摆臂" IsSelected="True" Tag="0" />
                            <local:MyComboBoxItem Content="轻微呼吸" Tag="1" />
                            <local:MyComboBoxItem Content="静态站姿" Tag="2" />
                        </local:MyComboBox>
                        <TextBlock Text="背部饰品" VerticalAlignment="Center" Margin="0,0,10,6" />
                        <local:MyComboBox x:Name="ComboBackAccessory" Width="154" Margin="0,0,18,6">
                            <local:MyComboBoxItem Content="自动 (有披风时显示)" IsSelected="True" Tag="Auto" />
                            <local:MyComboBoxItem Content="披风 (Cape)" Tag="Cape" />
                            <local:MyComboBoxItem Content="鞘翅 (Elytra)" Tag="Elytra" />
                            <local:MyComboBoxItem Content="不显示" Tag="None" />
                        </local:MyComboBox>
                        <TextBlock Text="预览背景" VerticalAlignment="Center" Margin="0,0,10,6" />
                        <local:MyComboBox x:Name="ComboPreviewBg" Width="130" Margin="0,0,18,6">
                            <local:MyComboBoxItem Content="透明棋盘" IsSelected="True" Tag="Checker" />
                            <local:MyComboBoxItem Content="纯白背景" Tag="White" />
                            <local:MyComboBoxItem Content="暗夜深灰" Tag="Dark" />
                            <local:MyComboBoxItem Content="绿幕 (#00FF00)" Tag="Green" />
                            <local:MyComboBoxItem Content="晴空渐变" Tag="Sky" />
                        </local:MyComboBox>
                        <local:MyCheckBox x:Name="ChkShowOuterLayer" Checked="True" Text="显示外层装饰" Margin="0,0,18,6" VerticalAlignment="Center" />
                        <local:MyButton x:Name="BtnResetCamera" Text="重置视角" MinWidth="88" Height="28" Padding="10,0" Margin="0,0,0,6" />
                    </WrapPanel>

                    <Border x:Name="ViewportHost" Height="420" CornerRadius="8" BorderThickness="1" BorderBrush="#1A000000" Background="#12000000" ClipToBounds="True" Cursor="SizeAll">
                        <Viewport3D x:Name="SkinViewport" RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Viewport3D.Camera>
                                <PerspectiveCamera x:Name="MainCamera" Position="0,0.4,7.2" LookDirection="0,-0.05,-1" UpDirection="0,1,0" FieldOfView="40" />
                            </Viewport3D.Camera>
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <Model3DGroup>
                                        <AmbientLight Color="#FFA8A8A8" />
                                        <DirectionalLight Color="#FFFFFFFF" Direction="-0.4,-0.5,-1" />
                                        <DirectionalLight Color="#FF666666" Direction="0.6,0.3,0.8" />
                                    </Model3DGroup>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>
                            <ModelVisual3D x:Name="CharacterVisual" />
                        </Viewport3D>
                    </Border>
                </StackPanel>
            </local:MyCard>
            <TextBlock HorizontalAlignment="Center" Margin="0,-5,0,16" FontSize="12" Opacity="0.5"
                       Foreground="{DynamicResource ColorBrush1}" Text="PCL Linking修改版 v 1.1.2 · 基于 PCL 2.14.0.0 开源版二次开发" />

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
