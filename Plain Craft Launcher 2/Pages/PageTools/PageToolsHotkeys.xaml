<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageToolsHotkeys"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,40">

            <local:MyCard Title="添加快捷键" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="按键组合" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyButton Grid.Column="1" x:Name="BtnCaptureKey" Text="点击录制快捷键" Height="28" Padding="10,0" />
                        <TextBlock Grid.Column="3" Text="触发功能" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyComboBox Grid.Column="4" x:Name="ComboAction" />
                    </Grid>
                    <local:MyCheckBox x:Name="ChkOnlyFocused" Checked="False" Text="仅在 PCL Linking 窗口聚焦时响应" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnAddBinding" Text="添加到绑定表" MinWidth="128" Height="32" Padding="14,0" ColorType="Highlight" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnClearAllBindings" Text="清空全部" MinWidth="96" Height="32" Padding="12,0" ColorType="Red" Margin="0,0,14,0" />
                        <TextBlock x:Name="LabCaptureHint" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource ColorBrush2}" Text="" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardBindingsList" Title="已绑定快捷键 (0)" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <local:MyHint x:Name="HintNoBindings" Visibility="Visible" Theme="Blue" Margin="0,0,0,2"
                                  Text="暂无快捷键绑定" />
                    <StackPanel x:Name="PanBindingsList" />
                </StackPanel>
            </local:MyCard>
            <TextBlock HorizontalAlignment="Center" Margin="0,-5,0,16" FontSize="12" Opacity="0.5"
                       Foreground="{DynamicResource ColorBrush1}" Text="PCL Linking修改版 v 1.0.1 · 基于 PCL 2.14.0.0 开源版二次开发" />

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
