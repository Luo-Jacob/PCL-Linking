<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageToolsServer"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,40">

            <local:MyCard Title="服务端核心与目录" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="服务端档案" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyComboBox Grid.Column="1" x:Name="ComboServerProfiles" Height="28" Margin="0,0,8,0" />
                        <local:MyButton Grid.Column="2" x:Name="BtnSaveServerProfile" Text="保存档案" MinWidth="82" Height="28" Padding="10,0" ColorType="Highlight" Margin="0,0,8,0" />
                        <local:MyButton Grid.Column="3" x:Name="BtnDeleteServerProfile" Text="删除" MinWidth="60" Height="28" Padding="10,0" ColorType="Red" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="服务端核心" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyComboBox Grid.Row="0" Grid.Column="1" x:Name="ComboServerType">
                            <local:MyComboBoxItem Content="Paper (推荐)" Tag="Paper" IsSelected="True" />
                            <local:MyComboBoxItem Content="Purpur" Tag="Purpur" />
                            <local:MyComboBoxItem Content="Vanilla (原版)" Tag="Vanilla" />
                            <local:MyComboBoxItem Content="Fabric" Tag="Fabric" />
                            <local:MyComboBoxItem Content="NeoForge" Tag="NeoForge" />
                            <local:MyComboBoxItem Content="Forge" Tag="Forge" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="MC 版本" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyComboBox Grid.Row="0" Grid.Column="4" x:Name="ComboServerMcVer" IsEditable="True" IsTextSearchEnabled="False">
                            <local:MyComboBoxItem Content="1.21.4" />
                            <local:MyComboBoxItem Content="1.21.1" IsSelected="True" />
                            <local:MyComboBoxItem Content="1.20.4" />
                            <local:MyComboBoxItem Content="1.20.1" />
                            <local:MyComboBoxItem Content="1.19.2" />
                            <local:MyComboBoxItem Content="1.18.2" />
                            <local:MyComboBoxItem Content="1.16.5" />
                            <local:MyComboBoxItem Content="1.12.2" />
                        </local:MyComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="运行 Java" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <local:MyComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" x:Name="ComboServerJava" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="服务端目录" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox Grid.Column="0" x:Name="TextServerDir" Margin="0,0,8,0" HintText="" />
                            <local:MyButton Grid.Column="1" x:Name="BtnBrowseServerDir" Text="选择目录" MinWidth="88" Height="28" Padding="10,0" Margin="0,0,8,0" />
                            <local:MyButton Grid.Column="2" x:Name="BtnOpenServerDir" Text="打开目录" MinWidth="88" Height="28" Padding="10,0" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="服务端参数配置" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="监听端口" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="1" x:Name="TextPropPort" Text="25565" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="最大人数" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="4" x:Name="TextPropMaxPlayers" Text="20" />
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="视距" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="7" x:Name="TextPropViewDistance" Text="10" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="游戏模式" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyComboBox Grid.Row="2" Grid.Column="1" x:Name="ComboPropGamemode">
                            <local:MyComboBoxItem Content="生存 (survival)" Tag="survival" IsSelected="True" />
                            <local:MyComboBoxItem Content="创造 (creative)" Tag="creative" />
                            <local:MyComboBoxItem Content="冒险 (adventure)" Tag="adventure" />
                            <local:MyComboBoxItem Content="旁观 (spectator)" Tag="spectator" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="游戏难度" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyComboBox Grid.Row="2" Grid.Column="4" x:Name="ComboPropDifficulty">
                            <local:MyComboBoxItem Content="和平 (peaceful)" Tag="peaceful" />
                            <local:MyComboBoxItem Content="简单 (easy)" Tag="easy" />
                            <local:MyComboBoxItem Content="普通 (normal)" Tag="normal" IsSelected="True" />
                            <local:MyComboBoxItem Content="困难 (hard)" Tag="hard" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="6" Text="初始内存" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="7" x:Name="TextJvmXms" Text="1024M" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="标语 MOTD" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyTextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" x:Name="TextPropMotd" Text="" HintText="可选" />
                        <TextBlock Grid.Row="4" Grid.Column="6" Text="最大内存" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyTextBox Grid.Row="4" Grid.Column="7" x:Name="TextJvmXmx" Text="4096M" />
                    </Grid>

                    <WrapPanel Margin="0,0,0,10">
                        <local:MyCheckBox x:Name="ChkPropOnlineMode" Checked="False" Text="开启正版验证 (online-mode)" Margin="0,0,20,6" />
                        <local:MyCheckBox x:Name="ChkPropPvp" Checked="True" Text="允许玩家 PVP" Margin="0,0,20,6" />
                        <local:MyCheckBox x:Name="ChkServerNogui" Checked="True" Text="无图形界面运行 (--nogui)" Margin="0,0,20,6" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                        <local:MyCheckBox x:Name="ChkAutoRestartOnCrash" Checked="True" Text="崩溃自动重启（上限 3 次）" Margin="0,0,18,6" VerticalAlignment="Center" />
                        <local:MyCheckBox x:Name="ChkAutoBackupWorld" Checked="False" Text="定时自动备份世界" Margin="0,0,8,6" VerticalAlignment="Center" />
                        <local:MyComboBox x:Name="ComboBackupInterval" Width="100" Height="26" Margin="0,0,10,6">
                            <local:MyComboBoxItem Content="30 分钟" Tag="30" />
                            <local:MyComboBoxItem Content="60 分钟" Tag="60" IsSelected="True" />
                            <local:MyComboBoxItem Content="120 分钟" Tag="120" />
                            <local:MyComboBoxItem Content="240 分钟" Tag="240" />
                        </local:MyComboBox>
                        <local:MyButton x:Name="BtnBackupWorldNow" Text="立即备份世界" Height="26" Padding="10,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnOpenBackupsDir" Text="打开备份目录" Height="26" Padding="10,0" Margin="0,0,0,6" />
                    </WrapPanel>

                    <Border Height="1" Background="#1A000000" Margin="0,2,0,12" />

                    <local:MyCheckBox x:Name="ChkAcceptEula" Checked="False" Margin="0,0,0,12"
                                      Text="我已阅读并同意 Mojang 服务端 EULA 协议" />

                    <WrapPanel>
                        <local:MyButton x:Name="BtnGenerateServer" Text="一键生成服务端" MinWidth="148" Height="32" Padding="14,0" ColorType="Highlight" Margin="0,0,10,6" />
                        <local:MyButton x:Name="BtnStartServer" Text="启动服务端" MinWidth="108" Height="32" Padding="14,0" Margin="0,0,10,6" />
                        <local:MyButton x:Name="BtnStopServer" Text="安全停服" MinWidth="96" Height="32" Padding="12,0" IsEnabled="False" Margin="0,0,10,6" />
                        <local:MyButton x:Name="BtnKillServer" Text="强制结束进程" MinWidth="112" Height="32" Padding="12,0" ColorType="Red" IsEnabled="False" Margin="0,0,10,6" />
                        <local:MyButton x:Name="BtnShareServerToLink" Text="一键共享到联机房间" MinWidth="148" Height="32" Padding="14,0" Margin="0,0,10,6"
                                        ToolTip="使用当前服务端端口一键创建 EasyTier 联机房间，并可发给好友" />
                    </WrapPanel>
                    <TextBlock x:Name="LabServerStatus" Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource ColorBrush2}" Text="就绪" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="服务端控制台" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                            Background="{DynamicResource ColorBrushSurface}"
                            BorderBrush="{DynamicResource ColorBrushGray5}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="LabMonState" Text="状态：未运行" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorBrush1}" Margin="0,2,16,2" />
                                <TextBlock x:Name="LabMonRam" Text="内存：--" FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray2}" Margin="0,2,16,2" />
                                <TextBlock x:Name="LabMonUptime" Text="运行时长：--" FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray2}" Margin="0,2,16,2" />
                                <TextBlock x:Name="LabMonPlugins" Text="插件/Mod：--" FontSize="12"
                                           Foreground="{DynamicResource ColorBrushGray2}" Margin="0,2,8,2" />
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <local:MyButton x:Name="BtnDownloadServerPlugin" Text="下载插件 / Mod" Height="26" Padding="10,0" Margin="0,0,8,0" ColorType="Highlight"
                                                ToolTip="跳转到社区资源页，点击具体版本右侧按钮可直接装入当前服务端 plugins / mods 目录" />
                                <local:MyButton x:Name="BtnOpenServerPluginsDir" Text="管理插件/Mod目录" Height="26" Padding="10,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <WrapPanel Margin="0,0,0,10">
                        <local:MyButton x:Name="BtnQuickSaveAll" Text="保存世界" Height="26" Padding="10,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnQuickList" Text="在线玩家" Height="26" Padding="10,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnQuickDay" Text="设为白天" Height="26" Padding="10,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnQuickWeatherClear" Text="天气放晴" Height="26" Padding="10,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnQuickKeepInv" Text="开启死亡不掉落" Height="26" Padding="10,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnQuickTps" Text="查看 TPS" Height="26" Padding="10,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnQuickBroadcast" Text="发全服公告" Height="26" Padding="10,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnQuickKick" Text="踢出玩家" Height="26" Padding="10,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnQuickBan" Text="封禁玩家" Height="26" Padding="10,0" Margin="0,0,8,6" ColorType="Red" />
                    </WrapPanel>
                    <Border CornerRadius="6" ClipToBounds="True" Background="#FF161A22" BorderThickness="1" BorderBrush="#22000000" Margin="0,0,0,10">
                        <TextBox x:Name="TextServerConsole" Height="280" IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Microsoft YaHei" FontSize="12"
                                 Background="Transparent" Foreground="#FFE5E9F0" BorderThickness="0" Padding="10" />
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox Grid.Column="0" x:Name="TextServerCommand" HintText="输入控制台指令并按回车" Margin="0,0,8,0" />
                        <local:MyButton Grid.Column="1" x:Name="BtnSendCommand" Text="发送指令" MinWidth="92" Height="28" Padding="10,0" ColorType="Highlight" Margin="0,0,8,0" />
                        <local:MyButton Grid.Column="2" x:Name="BtnClearConsole" Text="清空日志" MinWidth="92" Height="28" Padding="10,0" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardServerPlugins" Title="服务端插件管理与一键更新" Margin="0,0,0,15" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,18">
                    <WrapPanel Margin="0,0,0,10">
                        <local:MyButton x:Name="BtnRefreshServerPlugins" Text="刷新列表" Height="28" Padding="12,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnCheckPluginDeps" Text="依赖体检" Height="28" Padding="12,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnCheckPluginUpdates" Text="检查插件更新" Height="28" Padding="12,0" ColorType="Highlight" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnInstallMorePlugins" Text="下载新插件" Height="28" Padding="12,0" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock x:Name="LabServerPluginsSummary" Text="当前目录尚未扫描插件" FontSize="12.5" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,8" />
                    <local:MyHint x:Name="HintServerPluginDeps" Visibility="Collapsed" Theme="Yellow" Margin="0,0,0,10" />
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PanServerPluginList" />
                    </ScrollViewer>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardServerPerfConfig" Title="高级配置与性能预设（支持 Paper / Aikar / ZGC）" Margin="0,0,0,15" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,18">
                    <WrapPanel Margin="0,0,0,12">
                        <local:MyButton x:Name="BtnPresetSmoothCoop" Text="套用「联机流畅」预设" Height="28" Padding="12,0" Margin="0,0,8,6"
                                        ToolTip="视距 10、模拟距离 6、开启 Aikar's Flags、优化爆炸与自动保存区块速率，适合朋友联机。" />
                        <local:MyButton x:Name="BtnPresetLowSpec" Text="套用「低配轻量」预设" Height="28" Padding="12,0" Margin="0,0,8,6"
                                        ToolTip="降低视距与刷怪上限、提升网络压缩阈值，适合低配电脑开服。" />
                        <local:MyButton x:Name="BtnPresetVanilla" Text="恢复「原版默认」" Height="28" Padding="12,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnReloadPerfConfig" Text="重新读取" Height="28" Padding="12,0" Margin="0,0,8,6" />
                        <local:MyButton x:Name="BtnSavePerfConfig" Text="保存高级配置" Height="28" Padding="14,0" ColorType="Highlight" Margin="0,0,0,6" />
                    </WrapPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="模拟距离" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="simulation-distance：实体、红石与农作物实际刻更新范围（默认 10，联机建议 5~7）。" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="1" x:Name="TextPerfSimDist" Text="10" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="出生点保护" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="spawn-protection：非 OP 玩家无法破坏出生点半径内方块（设为 0 可取消限制）。" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="4" x:Name="TextPerfSpawnProt" Text="16" />
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="网络压缩阈值" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="network-compression-threshold：超过此字节数的数据包才压缩（默认 256，局域网可设 512）。" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="7" x:Name="TextPerfNetCompress" Text="256" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="单 Tick 超时" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="max-tick-time：卡死多少毫秒后触发看门狗强制停服（毫秒，设为 -1 禁用，Mod 服建议加大）。" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="1" x:Name="TextPerfMaxTick" Text="60000" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="怪物上限" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="bukkit.yml → spawn-limits.monsters（Paper/Purpur 有效）。" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="4" x:Name="TextPerfMonsters" Text="70" />
                        <TextBlock Grid.Row="2" Grid.Column="6" Text="动物上限" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="bukkit.yml → spawn-limits.animals（Paper/Purpur 有效）。" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="7" x:Name="TextPerfAnimals" Text="10" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Paper 存区块/Tick" VerticalAlignment="Center" Margin="0,0,10,0"
                                   ToolTip="paper-world-defaults.yml → chunks.max-auto-save-chunks-per-tick（建议 6~10 降低自动存盘卡顿）。" />
                        <local:MyTextBox Grid.Row="4" Grid.Column="1" x:Name="TextPerfAutoSaveChunks" Text="24" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="JVM GC 预设" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyComboBox Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="4" x:Name="ComboServerJvmPreset">
                            <local:MyComboBoxItem Content="标准默认（无额外 GC 参数）" Tag="Standard" IsSelected="True" />
                            <local:MyComboBoxItem Content="Aikar's Flags（Paper / Purpur / Mod 服通用高吞吐推荐）" Tag="Aikar" />
                            <local:MyComboBoxItem Content="Java 21+ 分代 ZGC（极低 STW 卡顿，自动适配 Java 23/25）" Tag="GenerationalZGC" />
                        </local:MyComboBox>
                    </Grid>

                    <WrapPanel Margin="0,2,0,0">
                        <local:MyCheckBox x:Name="ChkPerfAllowFlight" Checked="False" Text="允许飞行 (allow-flight)" Margin="0,0,18,6" />
                        <local:MyCheckBox x:Name="ChkPerfCommandBlock" Checked="False" Text="启用命令方块" Margin="0,0,18,6" />
                        <local:MyCheckBox x:Name="ChkPerfSyncChunk" Checked="True" Text="同步区块写入 (关闭可降卡顿)" Margin="0,0,18,6" />
                        <local:MyCheckBox x:Name="ChkPerfOptimizeExp" Checked="False" Text="Paper 优化爆炸计算" Margin="0,0,18,6" />
                        <local:MyCheckBox x:Name="ChkPerfPreventUnloaded" Checked="True" Text="阻止实体移入未加载区块" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="服务端运维与存档互通" Margin="0,0,0,15" CanSwap="True">
                <StackPanel Margin="25,40,25,18">
                    <WrapPanel Margin="0,0,0,10">
                        <local:MyButton x:Name="BtnAddToClientServers" Text="添加到当前实例服务器列表" Height="30" Padding="12,0" ColorType="Highlight" Margin="0,0,10,6" />
                        <local:MyButton x:Name="BtnCreateServerShortcut" Text="创建直连服务端快捷方式" Height="30" Padding="12,0" Margin="0,0,10,6" />
