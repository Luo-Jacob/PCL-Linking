<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageToolsToolbox"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,40">

            <local:MyCard Title="百宝箱" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <WrapPanel Margin="0,0,0,4">
                        <local:MyButton x:Name="BtnClearRubbish" Text="清理垃圾" MinWidth="122" Height="34" Padding="14,0" Margin="0,0,12,10" ColorType="Highlight"
                                        ToolTip="清理缓存、临时文件与 7 天前旧日志压缩包，不删除存档与 Mod" />
                        <local:MyButton x:Name="BtnJrrp" Text="今日人品" MinWidth="112" Height="34" Padding="14,0" Margin="0,0,12,10" />
                        <local:MyButton x:Name="BtnCreateShortcut" Text="创建桌面快捷方式" MinWidth="148" Height="34" Padding="14,0" Margin="0,0,12,10" />
                        <local:MyButton x:Name="BtnOpenDataDir" Text="打开配置与日志目录" MinWidth="156" Height="34" Padding="14,0" Margin="0,0,0,10" />
                    </WrapPanel>
                    <TextBlock x:Name="LabQuickStatus" Text="已整合原 PCL 百宝箱常用实用功能，更多工具请查看左侧「百宝箱」分栏。"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource ColorBrushGray2}" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="自定义下载" CanSwap="True" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock Text="直接通过 HTTP / HTTPS 链接下载文件到指定本地文件夹，可随时取消或一键打开目标目录。"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource ColorBrushGray2}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="下载链接" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TextDownloadUrl"
                                         HintText="https://example.com/file.zip" MaxLength="1000" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="保存目录" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="1" x:Name="TextDownloadFolder"
                                         HintText="留空默认保存到桌面" MaxLength="500" />
                        <local:MyTextButton Grid.Row="2" Grid.Column="2" x:Name="BtnDownloadPickFolder" Text="选择" Margin="10,0,4,0" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="文件名" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <local:MyTextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TextDownloadName"
                                         HintText="留空自动从链接末尾文件名推断" MaxLength="220" />
                    </Grid>
                    <WrapPanel VerticalAlignment="Center">
                        <local:MyButton x:Name="BtnDownloadStart" Text="开始下载" MinWidth="124" Height="32" Padding="14,0" ColorType="Highlight" Margin="0,0,10,6" />
                        <local:MyButton x:Name="BtnDownloadOpenDir" Text="打开目标目录" MinWidth="124" Height="32" Padding="14,0" Margin="0,0,12,6" />
                        <TextBlock x:Name="LabDownloadProgress" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource ColorBrush2}" Text="" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="Minecraft 成就图标生成" CanSwap="True" IsSwapped="True" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="展示图标" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <local:MyComboBox Grid.Row="0" Grid.Column="1" x:Name="ComboAchIcon">
                            <local:MyComboBoxItem Content="草方块" IsSelected="True" Tag="Grass.png" />
                            <local:MyComboBoxItem Content="命令方块" Tag="CommandBlock.png" />
                            <local:MyComboBoxItem Content="红石块" Tag="RedstoneBlock.png" />
                            <local:MyComboBoxItem Content="铁砧" Tag="Anvil.png" />
                            <local:MyComboBoxItem Content="圆石" Tag="CobbleStone.png" />
                            <local:MyComboBoxItem Content="龙蛋" Tag="Egg.png" />
                            <local:MyComboBoxItem Content="自定义本地图片" Tag="__custom__" />
                        </local:MyComboBox>
                        <local:MyButton Grid.Row="0" Grid.Column="2" x:Name="BtnAchPickIcon" Text="选图片" Height="28" Padding="12,0" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="成就标题" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TextAchTitle" Text="获得进度！" HintText="第一行黄色标题（如：获得进度！）" MaxLength="40" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="主要内容" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <local:MyTextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TextAchLine1" Text="打开 PCL Linking 百宝箱" HintText="第二行白色说明文字" MaxLength="60" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="补充副行" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <local:MyTextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TextAchLine2" HintText="可选第三行灰色小字" MaxLength="60" />
                    </Grid>
                    <WrapPanel Margin="0,0,0,12">
                        <local:MyButton x:Name="BtnAchPreview" Text="生成预览" MinWidth="112" Height="30" Padding="14,0" ColorType="Highlight" Margin="0,0,10,6" />
                        <local:MyButton x:Name="BtnAchSave" Text="保存成就 PNG" MinWidth="128" Height="30" Padding="14,0" Margin="0,0,0,6" />
                    </WrapPanel>
                    <Border x:Name="BorderAchPreview" HorizontalAlignment="Left" Padding="10" CornerRadius="6"
                            Background="{DynamicResource ColorBrushSurface}" Visibility="Collapsed">
                        <Image x:Name="ImgAchPreview" Width="320" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </StackPanel>
            </local:MyCard>

            <TextBlock HorizontalAlignment="Center" Margin="0,-5,0,16" FontSize="12" Opacity="0.5"
                       Foreground="{DynamicResource ColorBrush1}" Text="PCL Linking修改版 v 1.1.0 · 基于 PCL 2.14.0.0 开源版二次开发" />

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
