<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageDownloadPresets"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,40">

            <local:MyCard Title="常用模组清单管理" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource ColorBrush2}"
                               Text="建立多个独立的常用方案，绑定你常用的 Mod 与材质包。选择目标 Minecraft 版本与加载器后，即可自动校验兼容版本并一键完成游戏与全部资源装配。" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="当前清单" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <local:MyComboBox Grid.Column="1" x:Name="ComboPreset" Margin="0,0,10,0" />
                        <local:MyButton Grid.Column="2" x:Name="BtnNewPreset" Text="新建清单" MinWidth="92" Height="30" Padding="10,0" Margin="0,0,8,0" ColorType="Highlight" />
                        <local:MyButton Grid.Column="3" x:Name="BtnRenamePreset" Text="重命名" MinWidth="78" Height="30" Padding="10,0" Margin="0,0,8,0" />
                        <local:MyButton Grid.Column="4" x:Name="BtnDeletePreset" Text="删除" MinWidth="68" Height="30" Padding="10,0" ColorType="Red" />
                    </Grid>
                    <WrapPanel Margin="0,0,0,8">
                        <local:MyButton x:Name="BtnImportPreset" Text="导入清单 (分享码/JSON)" Height="28" Padding="12,0" Margin="0,0,8,4" />
                        <local:MyButton x:Name="BtnExtractInstancePreset" Text="提取当前实例的 Mod 与材质包为清单" Height="28" Padding="12,0" Margin="0,0,8,4" />
                        <local:MyButton x:Name="BtnExportShareCode" Text="复制分享码" Height="28" Padding="12,0" Margin="0,0,8,4" />
                        <local:MyButton x:Name="BtnExportJsonFile" Text="导出 JSON 文件" Height="28" Padding="12,0" Margin="0,0,8,4" />
                    </WrapPanel>
                    <local:MyHint x:Name="HintNoPreset" Visibility="Collapsed" Theme="Blue"
                                  Text="当前还没有任何清单，点击右侧「新建清单」即可开始配置你的常用 Mod 与材质包组合。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardDeploy" Title="选定版本并一键下载配置" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏版本" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <local:MyComboBox Grid.Row="0" Grid.Column="1" x:Name="ComboDeployVersion" IsEditable="True" IsTextSearchEnabled="False" HintText="请选择或输入游戏版本">
                            <local:MyComboBoxItem Content="26.1" />
                            <local:MyComboBoxItem Content="1.21.8" />
                            <local:MyComboBoxItem Content="1.21.4" />
                            <local:MyComboBoxItem Content="1.21.1" />
                            <local:MyComboBoxItem Content="1.20.4" />
                            <local:MyComboBoxItem Content="1.20.1" />
                            <local:MyComboBoxItem Content="1.19.2" />
                            <local:MyComboBoxItem Content="1.18.2" />
                            <local:MyComboBoxItem Content="1.16.5" />
                            <local:MyComboBoxItem Content="1.12.2" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Mod 加载器" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <local:MyComboBox Grid.Row="0" Grid.Column="4" x:Name="ComboDeployLoader">
                            <local:MyComboBoxItem Content="Fabric（自动匹配最新版）" Tag="4" IsSelected="True" />
                            <local:MyComboBoxItem Content="NeoForge（自动匹配最新版）" Tag="16" />
                            <local:MyComboBoxItem Content="Forge（自动匹配推荐版）" Tag="1" />
                            <local:MyComboBoxItem Content="原版（无加载器，仅材质包）" Tag="0" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="实例名称" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <local:MyTextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" x:Name="TextDeployName" HintText="请输入实例名称" />
                    </Grid>
                    <local:MyCheckBox x:Name="CheckAutoFabricApi" Checked="True" Text="使用 Fabric 时自动安装对应版本 Fabric API（推荐）" Margin="0,2,0,10" />
                    <local:MyHint x:Name="HintLoaderCompat" Visibility="Collapsed" Theme="Yellow" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <local:MyButton x:Name="BtnDeployStart" Text="检测兼容性并一键下载装配" MinWidth="200" Height="34" Padding="16,0" ColorType="Highlight" Margin="0,0,14,0" />
                        <TextBlock x:Name="LabDeployStatus" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush2}" Text="" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardPresetItems" Title="当前清单已添加的资源 (0 项)" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,18">
                    <local:MyHint x:Name="HintEmptyItems" Theme="Blue" Margin="0,0,0,6"
                                  Text="该清单暂未添加任何 Mod 或材质包，请在下方搜索并添加你喜爱的资源。" />
                    <StackPanel x:Name="PanPresetItems" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardAddSearch" Title="搜索并添加 Mod / 材质包到清单" Margin="0,0,0,0">
                <StackPanel Margin="25,40,25,18">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="关键词" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyTextBox Grid.Column="1" x:Name="TextAddKeyword" HintText="例如 Sodium、AppleSkin、FullBright、Vanilla Tweaks" />
                        <TextBlock Grid.Column="3" Text="种类" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyComboBox Grid.Column="4" x:Name="ComboAddType">
                            <local:MyComboBoxItem Content="Mod" Tag="1" IsSelected="True" />
                            <local:MyComboBoxItem Content="材质包" Tag="4" />
                        </local:MyComboBox>
                        <TextBlock Grid.Column="6" Text="来源" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <local:MyComboBox Grid.Column="7" x:Name="ComboAddSource">
                            <local:MyComboBoxItem Content="全部" Tag="3" IsSelected="True" />
                            <local:MyComboBoxItem Content="Modrinth" Tag="2" />
                            <local:MyComboBoxItem Content="CurseForge" Tag="1" />
                        </local:MyComboBox>
                        <local:MyButton Grid.Column="9" x:Name="BtnAddSearch" Text="搜索" MinWidth="82" Height="30" Padding="12,0" ColorType="Highlight" />
                    </Grid>
                    <TextBlock x:Name="LabSearchStatus" Foreground="{DynamicResource ColorBrush2}" Margin="0,0,0,8" Visibility="Collapsed" />
                    <StackPanel x:Name="PanAddResults" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
