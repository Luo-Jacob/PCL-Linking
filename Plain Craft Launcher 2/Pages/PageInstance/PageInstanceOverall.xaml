<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:System="clr-namespace:System;assembly=mscorlib" 
    mc:Ignorable="d" x:Class="PageInstanceOverall"
    PanScroll="PanBack" Grid.IsSharedSizeScope="True">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="">
                <Grid Margin="10,7" Name="PanDisplayItem" />
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="" x:Name="CardPlaytime">
                <Grid Margin="18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LabPlaytimeSummary" Text="累计游玩：0 分钟  ·  有效启动：0 次  ·  最近：尚未游玩"
                               VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource ColorBrushGray2}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <local:MyButton Grid.Column="1" x:Name="BtnPlaytimeRanking" Text="全部实例统计排行" Height="26" Padding="11,0" />
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="个性化" x:Name="PanDisplay">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanDisplayIcon" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="图标" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Column="1" x:Name="ComboDisplayLogo">
                            <local:MyComboBoxItem Content="自动" IsSelected="True" Tag="" />
                            <local:MyComboBoxItem Content="自定义..." x:Name="ItemDisplayLogoCustom" Tag="PCL Linking\Logo.png" />
                            <local:MyComboBoxItem Content="圆石" Tag="pack://application:,,,/images/Blocks/CobbleStone.png" />
                            <local:MyComboBoxItem Content="命令方块" Tag="pack://application:,,,/images/Blocks/CommandBlock.png" />
                            <local:MyComboBoxItem Content="金块" Tag="pack://application:,,,/images/Blocks/GoldBlock.png" />
                            <local:MyComboBoxItem Content="草方块" Tag="pack://application:,,,/images/Blocks/Grass.png" />
                            <local:MyComboBoxItem Content="土径" Tag="pack://application:,,,/images/Blocks/GrassPath.png" />
                            <local:MyComboBoxItem Content="铁砧" Tag="pack://application:,,,/images/Blocks/Anvil.png" />
                            <local:MyComboBoxItem Content="红石块" Tag="pack://application:,,,/images/Blocks/RedstoneBlock.png" />
                            <local:MyComboBoxItem Content="红石灯（开）" Tag="pack://application:,,,/images/Blocks/RedstoneLampOn.png" />
                            <local:MyComboBoxItem Content="红石灯（关）" Tag="pack://application:,,,/images/Blocks/RedstoneLampOff.png" />
                            <local:MyComboBoxItem Content="鸡蛋" Tag="pack://application:,,,/images/Blocks/Egg.png" />
                            <local:MyComboBoxItem Content="布料（Fabric）" Tag="pack://application:,,,/images/Blocks/Fabric.png" />
                            <local:MyComboBoxItem Content="狐狸（NeoForge）" Tag="pack://application:,,,/images/Blocks/NeoForge.png" />
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Left" Text="分类" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Column="1" Grid.Row="2" x:Name="ComboDisplayType">
                            <local:MyComboBoxItem Content="自动" IsSelected="True" />
                            <local:MyComboBoxItem Content="从版本列表中隐藏" ToolTip="该版本默认将不会在版本列表中显示。&#xa;在版本列表页面按下 F11，即可查看所有隐藏的版本。" />
                            <local:MyComboBoxItem Content="可安装 Mod 的版本" />
                            <local:MyComboBoxItem Content="常规版本" />
                            <local:MyComboBoxItem Content="不常用版本" />
                            <local:MyComboBoxItem Content="愚人节版本" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid Margin="0,15,0,7" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnDisplayRename" Text="修改版本名" MinWidth="140" Padding="13,0" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnDisplayDesc" Text="修改版本描述" MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Column="1" />
                        <local:MyButton x:Name="BtnDisplayStar" Text="加入收藏夹" MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Column="2" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="快捷方式" x:Name="PanFolder">
                <WrapPanel Margin="25,30,25,20">
                    <local:MyButton x:Name="BtnFolderVersion" Text="版本文件夹" MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35" />
                    <local:MyButton x:Name="BtnFolderSaves" Text="存档文件夹" MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35"/>
                    <local:MyButton x:Name="BtnFolderMods" Text="Mod 文件夹" MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35"/>
                    <local:MyButton x:Name="BtnFolderScreen" Text="截图文件夹" MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35" />
                </WrapPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="高级管理" x:Name="PanManage">
                <WrapPanel Margin="25,30,25,20">
                    <local:MyButton x:Name="BtnManageScript" Text="导出启动脚本" MinWidth="140" Padding="13,0" Margin="0,10,16,0" Height="35" />
                    <local:MyButton x:Name="BtnManageShortcut" Text="创建桌面快捷方式" MinWidth="140" Padding="13,0" Margin="0,10,16,0" Height="35"
                                    ToolTip="在桌面创建该实例的 .lnk 快捷方式，双击可自动调起 PCL Linking 并启动该实例（保留账号正版/外置登录态）。" />
                    <local:MyButton x:Name="BtnManageGameLog" Text="打开实时日志" MinWidth="130" Padding="13,0" Margin="0,10,16,0" Height="35"
                                    ToolTip="打开游戏实时日志监控窗口，实时查看、筛选与导出客户端输出日志。" />
                    <local:MyButton x:Name="BtnManageInstanceDiff" Text="实例对比 (Diff)" MinWidth="135" Padding="13,0" Margin="0,10,16,0" Height="35"
                                    ToolTip="对比当前实例与其他实例的 Mod、加载器及 config 配置文件差异，支持一键补齐独有 Mod。" />
                    <local:MyButton x:Name="BtnManageMigrateOptions" Text="迁移键位与设置" MinWidth="140" Padding="13,0" Margin="0,10,16,0" Height="35"
                                    ToolTip="从其他实例选择性迁移按键绑定 (key_*)、画面或音频设置到当前实例（自动生成 .bak 备份）。" />
                    <local:MyButton x:Name="BtnManageKeyConflicts" Text="按键冲突检测" MinWidth="130" Padding="13,0" Margin="0,10,16,0" Height="35"
                                    ToolTip="扫描当前实例 options.txt 中重复绑定的冲突按键，并支持一键解绑冲突的非原版 Mod 按键。" />
                    <local:MyButton x:Name="BtnManageInstanceSlim" Text="一键瘦身清理" MinWidth="130" Padding="13,0" Margin="0,10,16,0" Height="35"
                                    ToolTip="扫描并清理历史崩溃报告、旧日志归档、Mixin 调试输出与临时文件，释放磁盘空间。" />
                    <local:MyButton x:Name="BtnManageCheck" Text="补全文件" MinWidth="130" Padding="13,0" Margin="0,10,16,0" Height="35" ToolTip="校验版本依赖文件是否完整，并重新下载 Assets 索引与缺失、校验失败的文件。&#xa;若游戏缺失音效，请尝试此项。" />
                    <local:MyButton x:Name="BtnManageDelete" Text="删除版本" MinWidth="120" Padding="13,0" Margin="0,10,0,0" Height="35" ColorType="Red" />
                </WrapPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
