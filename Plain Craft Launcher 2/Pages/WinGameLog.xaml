<Window x:Class="WinGameLog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCL"
        Title="Minecraft 实时日志监控与诊断 - PCL Linking修改版"
        Width="900" Height="580" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="/PCLLK;component/Images/icon.ico"
        Background="#FFF5F7FB">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="监控进程" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#334155" />
            <ComboBox Grid.Column="1" x:Name="ComboProcess" Height="28" VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="3" Text="级别过滤" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#334155" />
            <ComboBox Grid.Column="4" x:Name="ComboLevelFilter" Height="28" VerticalContentAlignment="Center" SelectedIndex="0">
                <ComboBoxItem Content="全部日志" Tag="ALL" />
                <ComboBoxItem Content="仅 WARN / ERROR" Tag="WARN" />
                <ComboBoxItem Content="仅 ERROR / 异常" Tag="ERROR" />
                <ComboBoxItem Content="仅 Mixin / Mod 报错" Tag="MIXIN" />
            </ComboBox>
            <TextBox Grid.Column="6" x:Name="TextSearch" Height="28" VerticalContentAlignment="Center" Padding="8,0"
                     ToolTip="按关键字或正则表达式筛选日志行（如 Mod ID、Exception、Mixin）" />
            <TextBlock Grid.Column="6" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0" Foreground="#94A3B8"
                       Text="输入关键字过滤（如 Mod名 / ERROR / Exception）">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text.Length, ElementName=TextSearch}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <CheckBox Grid.Column="7" x:Name="ChkRegexSearch" Content="正则" VerticalAlignment="Center" Margin="8,0,0,0"
                      ToolTip="启用正则表达式匹配筛选（忽略大小写）" />
        </Grid>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="ChkAutoScroll" IsChecked="True" Content="自动滚动到底部" VerticalAlignment="Center" Margin="0,0,14,4" />
            <CheckBox x:Name="ChkPauseStream" IsChecked="False" Content="暂停追加显示" VerticalAlignment="Center" Margin="0,0,14,4" />
            <Button x:Name="BtnDiagnoseCrash" Content="一键智能诊断报错" Height="26" Padding="10,0" Margin="0,0,8,4"
                    FontWeight="SemiBold" Background="#FF0284C7" Foreground="White" BorderThickness="0" />
            <Button x:Name="BtnRefreshProcs" Content="刷新进程列表" Height="26" Padding="10,0" Margin="0,0,8,4" />
            <Button x:Name="BtnCopyLog" Content="复制全部过滤日志" Height="26" Padding="10,0" Margin="0,0,8,4" />
            <Button x:Name="BtnExportLog" Content="导出 .log" Height="26" Padding="10,0" Margin="0,0,8,4" />
            <Button x:Name="BtnClearLog" Content="清空视图" Height="26" Padding="10,0" Margin="0,0,0,4" />
        </WrapPanel>

        <Border Grid.Row="2" Background="#11161F" CornerRadius="6" Padding="6">
            <ListBox x:Name="ListLogLines"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Extended"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,1" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3338BDF8" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}"
                                   Foreground="{Binding ForegroundBrush}"
                                   FontFamily="Consolas, Microsoft YaHei UI"
                                   FontSize="12"
                                   TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabStatus" Grid.Column="0" Text="等待 Minecraft 日志输出..." Foreground="#475569" VerticalAlignment="Center" FontSize="12" />
            <Button Grid.Column="1" x:Name="BtnOpenLatestLog" Content="打开实例 logs 文件夹" Height="26" Padding="10,0" />
        </Grid>
    </Grid>
</Window>
